# Copy to .env for local development. Never commit .env — it is gitignored.
#
# Only VITE_-prefixed names are exposed to the client bundle via import.meta.env.
#
# Share-link shortening needs nothing here: the page posts to the jb-shortlink worker's
# /shorten (workers/jb-shortlink), which holds the TinyURL key as a wrangler secret.

# GA4 measurement ID (G-XXXXXXXXXX). Optional, and intentionally left empty here:
# vite.config.mjs emits the analytics tag only when this is set, so local builds and
# Cloudflare preview deploys stay untagged. Set it on the Pages *production*
# environment only. Never applied to embed.html — see vite.config.mjs for why.
VITE_GA_MEASUREMENT_ID=
